---
import BaseHead from "../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import Body from "../components/navigation/Body.astro";
import HeadingBox from "../components/HeadingBox.astro";
import InfoCard from "../components/InfoCard.astro";
---

<!doctype html>
<html lang="fr">
  <head>
    <BaseHead
      title={SITE_TITLE}
      description={SITE_DESCRIPTION}
      canonicalURL="https://www.heritiersdedumnacus.fr/nousrejoindre/"
    />
  </head>
  <Body>
    <div class="container-custom py-12">
      <HeadingBox>Nous Rejoindre</HeadingBox>

      <div class="my-16 grid grid-cols-1 gap-12 lg:grid-cols-2">
        <div class="parchment-card">
          <h2 class="mb-6 border-b border-black/10 pb-4 text-center font-richard text-4xl">L'Association</h2>
          <div class="space-y-4 text-lg leading-relaxed">
            <p>
              Rejoindre <span class="font-bold">Les Héritiers de Dumnacus</span>, c'est intégrer une communauté de
              passionnés qui fait vivre le jeu de rôle à Angers depuis de nombreuses années.
            </p>
            <p>
              Que vous soyez un vétéran des premières éditions ou que vous n'ayez jamais touché un dé de votre vie,
              notre porte est grande ouverte. Nous privilégions la convivialité, le partage et l'imaginaire.
            </p>
            <div class="mt-8 rounded-lg border border-black/5 bg-black/5 p-6">
              <h4 class="mb-2 font-bold">Nos locaux :</h4>
              <p>12 rue Louis Boiramé, 49000 Angers (Résidence Arceau).</p>
            </div>
          </div>
        </div>

        <div class="space-y-8">
          <InfoCard heading="Séances d'essai">
            <p>
              Le jeu de rôle est une expérience unique qu'il faut vivre pour comprendre. C'est pourquoi nous offrons
              <span class="font-bold text-[var(--color-gold-light)]">3 séances d'essai gratuites</span>. Venez,
              asseyez-vous à une table, et voyez si l'ambiance vous plaît avant de vous engager !
            </p>
          </InfoCard>

          <InfoCard heading="Adhésion">
            <p>Pour soutenir l'association et accéder à toutes nos activités à l'année :</p>
            <ul class="mt-4 space-y-2">
              <li class="flex items-center justify-between border-b border-white/10 pb-2">
                <span>Tarif Normal</span>
                <span class="text-xl font-bold text-[var(--color-gold-light)]">20€ / an</span>
              </li>
              <li class="flex items-center justify-between border-b border-white/10 pb-2">
                <span>Tarif Étudiant</span>
                <span class="text-xl font-bold text-[var(--color-gold-light)]">15€ / an</span>
              </li>
            </ul>
            <p class="mt-4 text-sm italic opacity-80">L'adhésion court de septembre à septembre.</p>
          </InfoCard>
        </div>
      </div>

      <div class="parchment-highlight mx-auto mb-16 max-w-3xl text-center">
        <h3 class="paragraph-header mb-6">Prêt à lancer les dés ?</h3>
        <p class="mb-8 text-xl">
          La première étape est de vous faire connaître sur notre forum ou notre Discord. Présentez-vous brièvement et
          guettez les annonces de parties !
        </p>
        <div class="flex flex-col justify-center gap-4 sm:flex-row">
          <a
            href="https://heritiers-dumnacus.forumactif.org/"
            class="rounded-full bg-[var(--color-gold)] px-8 py-3 font-bold text-black no-underline hover:scale-105 hover:bg-white"
          >
            Aller sur le Forum
          </a>
          <a
            href="https://discord.gg/4qdqpWbYdA"
            class="rounded-full border-2 border-[var(--color-gold)] px-8 py-3 font-bold text-[var(--color-gold)] no-underline hover:scale-105 hover:bg-[var(--color-gold)] hover:text-black"
          >
            Rejoindre le Discord
          </a>
        </div>
      </div>
    </div>
  </Body>
</html>
