---
import BaseHead from "../../components/BaseHead.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { getCollection } from "astro:content";
import AlignedItems from "../../components/navigation/AlignedItems.astro";
import ImageCard from "../../components/ImageCard.astro";
import Body from "../../components/navigation/Body.astro";
import HeadingBox from "../../components/HeadingBox.astro";

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="fr">
  <head>
    <BaseHead
      title={SITE_TITLE}
      description={SITE_DESCRIPTION}
      canonicalURL="https://www.heritiersdedumnacus.fr/jeuxderole/"
    />
  </head>
  <Body>
    <div class="container-custom py-12">
      <HeadingBox>Nos Jeux de Rôle</HeadingBox>
      
      <p class="text-center text-xl max-w-2xl mx-auto my-12 italic opacity-90">
        Découvrez les univers dans lesquels nous nous aventurons. 
        Que ce soit pour une campagne épique ou un one-shot nerveux, il y a toujours une place à nos tables.
      </p>

      <div class="mb-10">
        <AlignedItems>
          <ImageCard
            text="Wrath & Glory"
            image="/rpg/wg.jpg"
            alt="Image de couverture du jeu de rôle Wrath and Glory"
          />
          <ImageCard text="Fallout 111" image="/rpg/fallout.jpg" alt="Image de couverture du jeu de rôle Fallout 111" />
          <ImageCard
            text="Vampire la Mascarade"
            image="/rpg/vampire.png"
            alt="Image de couverture du jeu de rôle Vampire la Mascarade"
          />
          <ImageCard text="Donjon de Poche" image="/rpg/donjondepoche.jpg" alt="Image du jeu rôle Donjon de Poche" />
        </AlignedItems>
        <br />
        <AlignedItems>
          <ImageCard
            text="Donjons et Dragons 5e"
            image="/rpg/DnD-Emblem.png"
            alt="Logo du jeu de rôle Donjons et Dragons"
          />
          <ImageCard text="Earthdawn" image="/rpg/earthdawn.jpg" alt="Image de couverture du jeu de rôle Earthdawn" />
          <ImageCard
            text="Âge Atlante"
            image="/rpg/ageatlante.jpg"
            alt="Illustration pour le jeu de rôle Aventuriers de l'Âge Atlante"
          />
          <ImageCard text="Zombies" image="/rpg/zombies.png" alt="Image de couverture du jeu de rôle Zombies" />
        </AlignedItems>
      </div>
    </div>
  </Body>
</html>
