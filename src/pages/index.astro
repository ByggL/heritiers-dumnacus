---
import BaseHead from "../components/BaseHead.astro";
import ImageCard from "../components/ImageCard.astro";
import ImageLinkCard from "../components/ImageLinkCard.astro";
import AlignedItems from "../components/navigation/AlignedItems.astro";
import Separator from "../components/Separator.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import InfoCard from "../components/InfoCard.astro";
import Body from "../components/navigation/Body.astro";
import HeadingBox from "../components/HeadingBox.astro";
---

<!doctype html>
<html lang="fr">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} canonicalURL="https://www.heritiersdedumnacus.fr" />
  </head>
  <Body>
    <div class="hero container-custom">
      <img
        src="/logo-new.png"
        id="bouclier-big"
        alt="Logo des Héritiers de Dumnacus : un monogramme 'HD' en or sur fond bleu"
      />
      <h1 class="slogan mt-8">Et si pour une fois, c'était vous le Héros ?</h1>
    </div>

    <div class="container-custom" itemscope itemtype="https://schema.org/LocalBusiness">
      <HeadingBox>
        Bienvenue chez les <span class="font-richardbold text-7xl text-[var(--color-gold)]">H</span>éritiers de <span
          class="font-richardbold text-7xl text-[var(--color-gold)]">D</span
        >umnacus !
      </HeadingBox>

      <!-- First row: 3 cards -->
      <div class="my-12 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        <InfoCard heading="Qui sommes-nous ?" itemprop="description">
          <p>
            Les Héritiers de Dumnacus sont une association de Jeux de Rôles située à Angers. Notre mission : partager
            notre passion en réunissant des joueurs de tous niveaux, et faire découvrir ce loisir à un public curieux
            lors d’événements ouverts à tous.
          </p>
        </InfoCard>

        <InfoCard heading="C'est pour vous ?" itemprop="isAccessibleForFree">
          <p>
            <span class="font-bold">Pas besoin d’adhérer tout de suite</span> : vous pouvez venir essayer
            <span class="font-bold">gratuitement durant trois séances</span>, sans engagement. C’est notre façon de vous
            accueillir comme il se doit dans l’univers du jeu de rôle.
          </p>
        </InfoCard>

        <InfoCard heading="Combien ça coûte ?" itemprop="priceRange">
          <p>
            L'adhésion coûte <span class="font-bold">20€ par an</span> (15€ pour les étudiants). En devenant membre :
          </p>
          <ul class="ml-6 mt-2 list-disc opacity-90">
            <li>accès à toutes nos parties,</li>
            <li>réductions chez nos boutiques partenaires,</li>
            <li>une communauté passionnée.</li>
          </ul>
        </InfoCard>
      </div>

      <!-- Second row: 3 cards -->
      <div class="mb-16 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        <div itemprop="address" class="parchment-highlight h-full">
          <h3 class="paragraph-header">Où nous trouver ?</h3>
          <p class="text-lg">
            Venez nous retrouver au <span class="font-bold">12 rue Louis Boiramé, 49000 Angers</span>, dans la résidence
            Arceau.<br />
            Entrée via le square Louis Boisramé. Un membre viendra vous ouvrir.
          </p>
        </div>

        <div itemprop="event" class="parchment-highlight h-full">
          <h3 class="paragraph-header">Quand joue-t-on ?</h3>
          <p class="text-lg">Nous organisons des parties chaque week-end :</p>
          <ul class="ml-6 mt-2 list-disc opacity-90">
            <li>le samedi soir</li>
            <li>le dimanche après-midi</li>
          </ul>
          <p class="mt-4">
            Prochaines parties sur notre
            <a
              href="https://heritiers-dumnacus.forumactif.org/"
              target="_blank"
              class="decoration-gold-light font-bold underline">forum</a
            > !
          </p>
        </div>

        <div class="parchment-highlight h-full">
          <h3 class="paragraph-header">Je veux essayer !</h3>
          <div class="space-y-4">
            <div class="flex items-center gap-4">
              <span class="font-richardbold text-4xl text-[var(--color-gold)]">1</span>
              <p>
                Allez sur notre <a
                  href="https://heritiers-dumnacus.forumactif.org/"
                  target="_blank"
                  class="font-bold underline">forum</a
                >.
              </p>
            </div>
            <div class="flex items-center gap-4">
              <span class="font-richardbold text-4xl text-[var(--color-gold)]">2</span>
              <p>Trouvez votre partie.</p>
            </div>
            <div class="flex items-center gap-4">
              <span class="font-richardbold text-4xl text-[var(--color-gold)]">3</span>
              <p>Inscrivez-vous !</p>
            </div>
          </div>
          <p class="mt-6 border-t border-white/20 pt-4 text-[16px] leading-relaxed text-[var(--color-gold-light)]">
            <span class="decoration-gold/30 font-bold underline">Note :</span> Âge minimum <b>18 ans</b>.
          </p>
        </div>
      </div>

      <Separator />

      <HeadingBox>En ce moment sur nos tables</HeadingBox>

      <div class="mt-10">
        <AlignedItems>
          <ImageCard text="Fallout 111" image="/rpg/fallout.jpg" alt="Image de couverture du jeu de rôle Fallout 111" />
          <ImageCard
            text="AD&D2 Amral"
            image="/rpg/aded2-bw.png"
            alt="Logo noir et blanc du jeu de rôle Advanced Dungeons & Dragons 2nd Edition : Amral"
            contain={true}
          />
          <ImageCard text="Donjon de Poche" image="/rpg/donjondepoche.jpg" alt="Image du jeu rôle Donjon de Poche" />
          <ImageCard text="Zombies" image="/rpg/zombies.png" alt="Image de couverture du jeu de rôle Zombies" />
        </AlignedItems>
      </div>

      <div class="mx-auto my-24 flex max-w-5xl flex-col justify-center gap-12 md:flex-row">
        <ImageLinkCard
          header="Notre Forum"
          href="https://heritiers-dumnacus.forumactif.org/"
          image="/forumactif-logo.png"
          text="L'espace privilégié pour l'organisation de toutes nos parties"
          alt="Logo de forumactif"
          className="min-h-[400px] flex-1"
        />
        <ImageLinkCard
          header="Notre Discord"
          href="https://discord.gg/4qdqpWbYdA"
          image="/Discord-Logo.png"
          text="Pour discuter en direct avec les membres de la communauté"
          alt="Logo de Discord"
          className="min-h-[400px] flex-1"
        />
      </div>
    </div>
  </Body>
</html>
