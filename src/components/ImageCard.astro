---
import "../styles/global.css";

interface Props {
  text: string;
  image: string;
  alt?: string;
  contain?: boolean;
}

const { text, image = "/logo-new.png", alt, contain = false } = Astro.props;
---

<div class="group flex flex-col justify-between transition-all duration-300 hover:scale-105" id="wrapper" itemscope itemprop="https://schema.org/Game">
  <div class="relative aspect-square w-full overflow-hidden rounded-2xl border-2 border-gray-500 shadow-xl" itemprop="image">
    <!-- Background parchment visible only through transparency -->
    <div class="absolute inset-0 z-0 bg-[url('/background-parchment.jpg')] bg-cover bg-center"></div>
    
    <img 
        src={image} 
        class:list={[
          "relative z-10 h-full w-full",
          contain ? "object-contain p-4" : "object-cover"
        ]}
        alt={alt} 
    />
  </div>

  <p class="mt-4 text-center font-richard text-xl font-bold text-white group-hover:text-[var(--color-gold-light)] transition-colors" itemprop="name">
    {text}
  </p>
</div>

<style>
  @media screen and (max-width: 600px) {
    #wrapper {
      width: 100%;
      max-width: 280px;
      margin: 0 auto 2rem auto;
    }
  }

  @media screen and (min-width: 601px) {
    #wrapper {
      width: 23.5%;
    }
  }

  #wrapper {
    margin-left: auto;
    margin-right: auto;
  }
</style>
