---
const today = new Date();
---

<footer class="border-t-2 border-[var(--color-gold)] px-6 pt-10 text-white">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 md:grid-cols-3 text-left">
    <div class="flex flex-col items-center md:items-start text-center md:text-left">
      <h2 class="mb-4 font-richard text-2xl text-[var(--color-gold-light)]">Héritiers de Dumnacus</h2>
      <p class="opacity-80 text-sm leading-relaxed max-w-xs">
        Association angevine de jeux de rôle. Venez incarner votre personnage et vivre des aventures épiques au cœur de l'Anjou !
      </p>
    </div>

    <div class="flex flex-col items-center md:items-start text-center md:text-left">
      <h3 class="mb-4 font-richard text-xl text-[var(--color-gold-light)]">Navigation</h3>
      <ul class="space-y-3 text-base">
        <li>
          <a href="/nousrejoindre" class="no-underline hover:text-[var(--color-gold-light)] transition-colors">Nous Rejoindre</a>
        </li>
        <li>
          <a href="/jeuxderole" class="no-underline hover:text-[var(--color-gold-light)] transition-colors">Jeux de Rôle</a>
        </li>
        <li>
          <a href="/about" class="no-underline hover:text-[var(--color-gold-light)] transition-colors">À Propos</a>
        </li>
        <li>
          <a href="https://heritiers-dumnacus.forumactif.org/" target="_blank" class="no-underline hover:text-[var(--color-gold-light)] transition-colors">Le Forum</a>
        </li>
      </ul>
    </div>

    <div class="flex flex-col items-center md:items-start text-center md:text-left">
      <h3 class="mb-4 font-richard text-xl text-[var(--color-gold-light)]">Contact & Réseaux</h3>
      <div class="flex space-x-6 mb-6">
        <a href="https://facebook.com" target="_blank" class="hover:text-[var(--color-gold-light)] transition-all hover:scale-110" aria-label="Facebook">
          <svg viewBox="0 0 16 16" width="28" height="28" fill="currentColor"><path d="M16 8.049c0-4.446-3.582-8.05-8-8.05C3.58 0-.002 3.603-.002 8.05c0 4.017 2.926 7.347 6.75 7.951v-5.625h-2.03V8.05H6.75V6.275c0-2.017 1.195-3.131 3.022-3.131.876 0 1.791.157 1.791.157v1.98h-1.009c-.993 0-1.303.621-1.303 1.258v1.51h2.218l-.354 2.326H9.25V16c3.824-.604 6.75-3.934 6.75-7.951"></path></svg>
        </a>
        <a href="https://discord.gg/4qdqpWbYdA" target="_blank" class="hover:text-[var(--color-gold-light)] transition-all hover:scale-110" aria-label="Discord">
            <svg viewBox="0 0 127.14 96.36" width="28" height="28" fill="currentColor"><path d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.71,32.65-1.82,56.6.39,80.21a105.73,105.73,0,0,0,32.21,16.15c2.45-3.35,4.6-6.9,6.44-10.59a67.73,67.73,0,0,1-10.25-4.85c.87-.64,1.72-1.31,2.54-2a82.7,82.7,0,0,0,7.31,3.69c26.48,12.11,55.06,12.11,81.18,0a82.51,82.51,0,0,0,7.31-3.69c.82.69,1.67,1.36,2.54,2a67.59,67.59,0,0,1-10.25,4.85c1.84,3.69,3.99,7.24,6.44,10.59a105.6,105.6,0,0,0,32.21-16.15C129.58,50.8,124,27.1,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,46,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,46,96.12,53,91.07,65.69,84.69,65.69Z"></path></svg>
        </a>
        <a href="mailto:heritiers.dumnacus@gmail.com" class="hover:text-[var(--color-gold-light)] transition-all hover:scale-110" aria-label="Email">
          <svg viewBox="0 0 16 16" width="28" height="28" fill="currentColor"><path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1zm13 2.383-4.708 2.825L15 11.105zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741M1 11.105l4.708-2.897L1 5.383z"></path></svg>
        </a>
      </div>
      <p class="text-xs opacity-60 italic">Réponse sous 48h en général.</p>
    </div>
  </div>

  <div class="mt-12 pt-8 border-t border-white/5 text-center text-xs opacity-50 tracking-widest uppercase">
    © {today.getFullYear()} Héritiers de Dumnacus — Association Loi 1901
  </div>
</footer>

<style>
  footer {
    background-color: rgba(0, 50, 100, 0.9);
    backdrop-blur: 8px;
    position: relative;
    z-index: 10;
  }
</style>
