---
import "../styles/global.css";

interface Props {
  text: string;
  image: string;
  href: string;
  header: string;
  alt?: string;
  className?: string;
}

const { text, image = "/logo-new.png", href, header, alt, className } = Astro.props;
---

<div class:list={["group relative flex flex-col items-center justify-center bg-gradient-to-b from-black/60 to-blue-900/40 p-10 rounded-3xl border-2 border-[var(--color-gold)] backdrop-blur-md transition-all duration-500 hover:border-[var(--color-gold-light)] hover:shadow-[0_0_30px_rgba(212,175,55,0.3)] hover:-translate-y-2", className]} id="wrapper">
  <!-- Decorative corner accents -->
  <div class="absolute top-2 left-2 w-4 h-4 border-t-2 border-l-2 border-[var(--color-gold)] opacity-50 group-hover:opacity-100 transition-opacity"></div>
  <div class="absolute top-2 right-2 w-4 h-4 border-t-2 border-r-2 border-[var(--color-gold)] opacity-50 group-hover:opacity-100 transition-opacity"></div>
  <div class="absolute bottom-2 left-2 w-4 h-4 border-b-2 border-l-2 border-[var(--color-gold)] opacity-50 group-hover:opacity-100 transition-opacity"></div>
  <div class="absolute bottom-2 right-2 w-4 h-4 border-b-2 border-r-2 border-[var(--color-gold)] opacity-50 group-hover:opacity-100 transition-opacity"></div>

  <a href={href} class="flex h-32 w-full items-center justify-center mb-4">
    <img src={image} class="max-h-full max-w-[80%] object-contain drop-shadow-[0_10px_10px_rgba(0,0,0,0.5)] transition-transform duration-500 group-hover:scale-110" alt={alt} />
  </a>
  
  <div class="text-center">
    <a href={href} class="text-3xl font-richard font-bold text-[var(--color-gold-light)] no-underline group-hover:text-white transition-colors block mb-2">
      {header}
    </a>
    <p class="text-base opacity-80 leading-snug max-w-[250px] mx-auto font-medium">
      {text}
    </p>
  </div>

  <div class="mt-8 overflow-hidden rounded-full">
    <a href={href} class="bg-[var(--color-gold)] hover:bg-white text-black px-8 py-2 font-bold text-sm uppercase tracking-widest no-underline transition-all inline-block">
        Rejoindre
    </a>
  </div>
</div>
